GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Morningstar Screener Sheet (ms_screener + trader_agent)
SHEET_ID=your-morningstar-sheet-id

# Portfolio Tracker Sheet (fidelity)
FIDELITY_SHEET_ID=your-fidelity-sheet-id
# FIDELITY_SHEET_ID=your-other-fidelity-sheet-id

# Morningstar API (screener tool) — RapidAPI keys, comma-separated
MORNINGSTAR_API_BASE_URL=https://morning-star.p.rapidapi.com
MORNINGSTAR_API_KEYS=key1,key2,key3

# Email alerts (screener tool)
EMAIL_USERNAME=your@email.com
EMAIL_PASSWORD=your-app-password
ALERT_EMAILS=recipient@email.com

# SPL library card (Morningstar access via Seattle Public Library)
SPL_BARCODE=your-barcode
SPL_PIN=your-pin
